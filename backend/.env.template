DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///db.sqlite3


# Google OAuth
GOOGLE_CLIENT_ID=**********
GOOGLE_CLIENT_SECRET=**********

# GitHub OAuth
GITHUB_CLIENT_ID=**********
GITHUB_CLIENT_SECRET=**********


# Email (Resend via django-anymail)
RESEND_API_KEY=re_your_resend_api_key_here
DEFAULT_FROM_EMAIL=Staqed <noreply@yourdomain.com>

# Frontend URL (used to build magic link URLs)
FRONTEND_URL=http://localhost:3000

# Storage Configuration
# Set to 'local', 'cloudinary', or 's3'
STORAGE_PROVIDER=local

# Cloudinary Keys (Required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=**********
CLOUDINARY_API_KEY=**********
CLOUDINARY_API_SECRET=**********

# AWS S3 Keys (Required if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=**********
AWS_SECRET_ACCESS_KEY=**********
AWS_STORAGE_BUCKET_NAME=**********
AWS_S3_REGION_NAME=us-east-1
